<Application x:Class="GameMusicShare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <Style x:Key="ActivationSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="SwitchLabel" Text="Off" Foreground="#AFC5E4" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Border x:Name="SwitchTrack" Width="40" Height="23" CornerRadius="12" Background="#42546B" BorderBrush="#6C859F" BorderThickness="1">
                <Ellipse x:Name="SwitchThumb" Width="17" Height="17" Margin="2" Fill="#F8FAFC" HorizontalAlignment="Left"/>
              </Border>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="SwitchTrack" Property="Background" Value="#21B899"/>
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#66EACD"/>
                <Setter TargetName="SwitchLabel" Property="Text" Value="Active"/>
                <Setter TargetName="SwitchLabel" Property="Foreground" Value="#79F4D4"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <FontFamily x:Key="InterFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>

    <Color x:Key="MidnightNavyColor">#0B1220</Color>
    <Color x:Key="GraphiteColor">#142332</Color>
    <Color x:Key="SatinColor">#2A3447</Color>
    <Color x:Key="CyanColor">#22D3EE</Color>
    <Color x:Key="MintColor">#34D399</Color>
    <Color x:Key="LavenderColor">#A78BFA</Color>
    <Color x:Key="CoralColor">#F87171</Color>
    <Color x:Key="WarmWhiteColor">#F8FAFC</Color>

    <SolidColorBrush x:Key="WarmWhite" Color="{StaticResource WarmWhiteColor}"/>
    <SolidColorBrush x:Key="Muted" Color="#AFC5E4"/>
    <SolidColorBrush x:Key="CyanSolid" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="MintSolid" Color="{StaticResource MintColor}"/>
    <SolidColorBrush x:Key="LavenderSolid" Color="{StaticResource LavenderColor}"/>
    <SolidColorBrush x:Key="CoralSolid" Color="{StaticResource CoralColor}"/>

    <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="0.18,1">
      <GradientStop Color="#294460" Offset="0"/>
      <GradientStop Color="#091A2E" Offset="0.09"/>
      <GradientStop Color="#0D2138" Offset="0.7"/>
      <GradientStop Color="#071526" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="0.25,1">
      <GradientStop Color="#2A4566" Offset="0"/>
      <GradientStop Color="#172F49" Offset="0.14"/>
      <GradientStop Color="#0B1D31" Offset="0.7"/>
      <GradientStop Color="#1A324B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Satin" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#314965" Offset="0"/>
      <GradientStop Color="#1A304A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Mint" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#61E7C8" Offset="0"/>
      <GradientStop Color="#27CF9D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Lavender" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#B6A4FF" Offset="0"/>
      <GradientStop Color="#8B7CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Coral" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF8A91" Offset="0"/>
      <GradientStop Color="#F06471" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Cyan" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#55D8FF" Offset="0"/>
      <GradientStop Color="#22AFFF" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
      <Setter Property="Foreground" Value="{StaticResource WarmWhite}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Control">
      <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource WarmWhite}"/>
      <Setter Property="Background" Value="{StaticResource Satin}"/>
      <Setter Property="BorderBrush" Value="#496887"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect Color="#030914" BlurRadius="8" ShadowDepth="2" Opacity="0.34"/>
              </Border.Effect>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons"
                           FontSize="17" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.9"/><Setter TargetName="Surface" Property="BorderBrush" Value="#8FB7DB"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#9CB4D3"/>
      <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <Style x:Key="MuteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Tag" Value="&#xE74F;"/>
      <Setter Property="Background" Value="{StaticResource Satin}"/>
      <Setter Property="BorderBrush" Value="#4A6788"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource WarmWhite}"/>
      <Setter Property="Background" Value="#0B1B2F"/>
      <Setter Property="BorderBrush" Value="#4B6D91"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#112940"/>
            <Setter Property="Padding" Value="11,8"/>
            <Style.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#294867"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1D3D59"/></Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="#0B1B2F" BorderBrush="#4B6D91" BorderThickness="1" CornerRadius="8">
                      <Path Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="#D9E8F8" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7DAAD2"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="12,0,32,0" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
              <TextBlock x:Name="Placeholder" Text="Choose a source" Foreground="#8199B6" Margin="12,0,32,0"
                         IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#112940" BorderBrush="#55799C" BorderThickness="1" CornerRadius="8"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Padding="3">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource CyanSolid}"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24">
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="#2C4865"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="19" Height="19">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" Stroke="#B9F5F7" StrokeThickness="0.7"><Ellipse.Effect><DropShadowEffect Color="#020914" BlurRadius="6" ShadowDepth="2" Opacity="0.5"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
